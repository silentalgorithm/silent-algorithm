            <div class="project-item__bg" aria-hidden="true"></div>
            <div class="project-item__content">
              <div class="project-item__always">
                <p class="project-item__cat">{{ proyecto.categoria }}</p>
                <h3 class="project-item__name">{{ proyecto.nombre }}</h3>
                <p class="project-item__year">{{ proyecto.year }}</p>
              </div>
              <div class="project-item__hover" aria-hidden="true">
                <p class="project-item__desc">{{ proyecto.descripcion }}</p>
                <ul class="project-item__stack">
                  {% for tech in proyecto.tecnologias %}
