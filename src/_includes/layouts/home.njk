{% extends "layouts/base.njk" %}

{% block extraJs %}
  <script src="/assets/js/home.js" defer></script>
  <script src="/assets/js/contact-form.js" defer></script>
{% endblock %}

{% block content %}

  {# ── HERO ── #}
  <section class="hero" id="inicio" aria-labelledby="hero-title">
    <div class="hero__grid-lines" aria-hidden="true"></div>
    <div class="hero__glow" aria-hidden="true"></div>

    <div class="container hero__inner">
      <div class="hero__content">
        <p class="hero__kicker reveal" aria-label="Establecida en 2022">
          <span aria-hidden="true"></span>Est. 2022 · Remote-first · Global
      </p>
        <h1 class="hero__title reveal reveal--delay-1" id="hero-title">
        Software que <em>piensa</em><br>
        mientras el mundo<br>
        duerme.
      </h1>
        <p class="hero__desc reveal reveal--delay-2">
        Construimos sistemas a medida, sitios web de alto impacto y scripts de automatización para empresas que entienden que el código bien escrito es ventaja competitiva sostenida.
      </p>
        <div class="hero__actions reveal reveal--delay-3">
          <a href="#servicios" class="btn btn--primary">Ver servicios</a>
          <a href="/blog/" class="btn btn--ghost">
          Leer el blog
          <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
        </div>
      </div>

      <div class="hero__visual reveal reveal--delay-2" aria-hidden="true">
        <div class="orbit">
          <div class="orbit__ring orbit__ring--1"></div>
          <div class="orbit__ring orbit__ring--2"></div>
          <div class="orbit__ring orbit__ring--3"></div>
          <div class="orbit__core">
            <span class="orbit__symbol">∮</span>
            <span class="orbit__label">Silent · Precise · Efficient</span>
          </div>
        </div>
      </div>
    </div>

    <div class="hero__stats container reveal reveal--delay-3">
      <div class="stat">
        <strong class="stat__number" data-count="48">0</strong>
        <span class="stat__label">Proyectos entregados</span>
      </div>
      <div class="stat">
        <strong class="stat__number">100%</strong>
        <span class="stat__label">Satisfacción cliente</span>
      </div>
      <div class="stat">
        <strong class="stat__number" data-count="3">0</strong>
        <span class="stat__label">Años de experiencia</span>
      </div>
      <div class="stat">
        <strong class="stat__number">24h</strong>
        <span class="stat__label">Tiempo de respuesta</span>
      </div>
    </div>
  </section>

  {# ── NOSOTROS ── #}
  <section class="section section--alt" id="nosotros" aria-labelledby="nosotros-title">
    <div class="container">
      <div class="about__grid">

        <div class="about__left">
          <p class="section__label reveal">
            <span aria-hidden="true"></span>Quiénes somos
        </p>
          <h2 class="section__title reveal reveal--delay-1" id="nosotros-title">
          No somos una agencia.<br>Somos un <em>estudio</em>.
        </h2>
          <p class="section__sub reveal reveal--delay-2">
          Pequeños de propósito, precisos de oficio. Cada proyecto recibe atención directa de quienes realmente entienden el problema.
        </p>

          <div class="pillars reveal reveal--delay-2">
            <div class="pillar">
              <span class="pillar__num">01</span>
              <h3 class="pillar__title">Silencio estratégico</h3>
              <p class="pillar__desc">Menos ruido. Más código funcional que crea valor real desde el día uno.</p>
            </div>
            <div class="pillar">
              <span class="pillar__num">02</span>
              <h3 class="pillar__title">Precisión quirúrgica</h3>
              <p class="pillar__desc">No construimos lo que no necesitas. Diseñamos lo exacto para tu problema.</p>
            </div>
            <div class="pillar">
              <span class="pillar__num">03</span>
              <h3 class="pillar__title">Código que perdura</h3>
              <p class="pillar__desc">Arquitecturas limpias, documentadas y escalables. Tu inversión crece contigo.</p>
            </div>
            <div class="pillar">
              <span class="pillar__num">04</span>
              <h3 class="pillar__title">Transparencia total</h3>
              <p class="pillar__desc">Sabes en qué etapa está tu proyecto, siempre. Sin sorpresas, sin letra chica.</p>
            </div>
          </div>
        </div>

        <div class="about__right reveal reveal--delay-2">
          <blockquote class="manifesto">
            <p>"El mejor algoritmo no es el más complejo — es el que resuelve el problema correcto con la elegancia exacta que requiere."</p>
            <cite>— Manifiesto · The Silent Algorithm</cite>
          </blockquote>
        </div>

      </div>
    </div>
  </section>

  {# ── SERVICIOS ── #}
  <section class="section" id="servicios" aria-labelledby="servicios-title">
    <div class="container">
      <div class="section__header">
        <div>
          <p class="section__label reveal">
            <span aria-hidden="true"></span>Lo que hacemos</p>
          <h2 class="section__title reveal reveal--delay-1" id="servicios-title">
          Tres disciplinas.<br>
            <em>Un solo estándar.</em>
          </h2>
        </div>
        <p class="section__sub reveal reveal--delay-2">
        Cada servicio es una especialidad cultivada durante años de proyectos reales.
      </p>
      </div>

      <div class="services-grid" role="list">
        {% for servicio in collections.servicios %}
          <article class="service-card reveal reveal--delay-{{ loop.index }}" role="listitem">
            <a href="{{ servicio.url }}" class="service-card__link" aria-label="Ver servicio: {{ servicio.data.title }}">
              <span class="service-card__num">Servicio · 0{{ loop.index }}</span>
              <div class="service-card__icon" aria-hidden="true">
                {% include "partials/icons/" + servicio.data.icono + ".njk" %}
              </div>
              <h3 class="service-card__title">{{ servicio.data.title }}</h3>
              <p class="service-card__desc">{{ servicio.data.resumen }}</p>
              <ul class="service-card__tags" aria-label="Tecnologías">
                {% for tag in servicio.data.tags %}
                  <li class="tag">{{ tag }}</li>
                {% endfor %}
              </ul>
              <span class="service-card__cta" aria-hidden="true">
            Explorar servicio <span>→</span>
              </span>
            </a>
          </article>
        {% endfor %}
      </div>
    </div>
  </section>

  {# ── PROYECTOS ── #}
  {# <section class="section section--alt" id="proyectos" aria-labelledby="proyectos-title">
    <div class="container">
      <div class="section__header">
        <div>
          <p class="section__label reveal">
            <span aria-hidden="true"></span>Trabajo selecto</p>
          <h2 class="section__title reveal reveal--delay-1" id="proyectos-title">
          Proyectos que<br>
            <em>hablan por sí solos.</em>
          </h2>
        </div>
      </div>

      <div class="projects-filter reveal" role="tablist" aria-label="Filtrar proyectos">
        <button class="filter-btn filter-btn--active" role="tab" aria-selected="true" data-filter="todos">Todo</button>
        <button class="filter-btn" role="tab" aria-selected="false" data-filter="Software a Medida">Software a Medida</button>
        <button class="filter-btn" role="tab" aria-selected="false" data-filter="Desarrollo Web">Web</button>
        <button class="filter-btn" role="tab" aria-selected="false" data-filter="Automatización">Automatización</button>
      </div>

      <div class="projects-grid reveal reveal--delay-1" id="projectsGrid" role="list">
        {% for proyecto in proyectos %}
