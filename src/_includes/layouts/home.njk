  {# ── BLOG ── #}
  <section class="section" id="blog" aria-labelledby="blog-title">
    <div class="container">
      <div class="section__header">
        <div>
          <p class="section__label reveal">
            <span aria-hidden="true"></span>El libro digital</p>
          <h2 class="section__title reveal reveal--delay-1" id="blog-title">
          Ideas que<br>
            <em>construyen autoridad.</em>
          </h2>
        </div>
        <a href="/blog/" class="btn btn--ghost reveal reveal--delay-2">Ver todos los artículos</a>
      </div>

      {% set featuredPosts = collections.destacados %}
      {% set recentPosts = collections.blog | primeros(6) %}

      {% if featuredPosts.length %}
        <div class="blog-featured reveal">
          {# ------------ Primer artículo destacado — grande #}
          {% set postFeatured = featuredPosts[0] %}
          <article class="blog-post blog-post--featured">
            <div class="blog-post__visual" aria-hidden="true">
              <div class="blog-post__visual-inner" style="{{ postFeatured.data.colorBg or 'background: var(--dusk)' }}"></div>
            </div>
            <div class="blog-post__body">
              <div class="post-meta">
                <span class="post-cat">{{ postFeatured.data.categoria }}</span>
                <time class="post-date" datetime="{{ postFeatured.date | fechaISO }}">{{ postFeatured.date | fechaCorta }}</time>
              </div>
              <h3 class="blog-post__title">
                <a href="{{ postFeatured.url }}">{{ postFeatured.data.title }}</a>
              </h3>
              <p class="blog-post__excerpt">{{ postFeatured.data.resumen }}</p>
              <a href="{{ postFeatured.url }}" class="post-read-more" aria-label="Leer: {{ postFeatured.data.title }}">
            Leer artículo <span aria-hidden="true">→</span>
              </a>
            </div>
          </article>

          {# --------------- Sidebar con 2 artículos secundarios #}
          <aside class="blog-sidebar">
            {% for post in featuredPosts | primeros(2) %}
              <article class="blog-post blog-post--side">
                <div class="post-meta">
                  <span class="post-cat">{{ post.data.categoria }}</span>
                  <time class="post-date" datetime="{{ post.date | fechaISO }}">{{ post.date | fechaCorta }}</time>
                </div>
                <h3 class="blog-post__title blog-post__title--sm">
                  <a href="{{ post.url }}">{{ post.data.title }}</a>
                </h3>
                <a href="{{ post.url }}" class="post-read-more" aria-label="Leer: {{ post.data.title }}">Leer <span aria-hidden="true">→</span>
                </a>
              </article>
            {% endfor %}
          </aside>
        </div>
      {% endif %}

      {# ------------ Grid de posts recientes #}
      <div class="blog-grid-secondary reveal reveal--delay-1" role="list">
        {% for post in recentPosts | primeros(3) %}
          <article class="blog-post-card" role="listitem">
            <div class="post-meta">
              <span class="post-cat">{{ post.data.categoria }}</span>
              <time class="post-date" datetime="{{ post.date | fechaISO }}">{{ post.date | fechaCorta }}</time>
            </div>
            <h3 class="blog-post-card__title">
              <a href="{{ post.url }}">{{ post.data.title }}</a>
            </h3>
            <p class="blog-post-card__excerpt">{{ post.data.resumen | truncar(120) }}</p>
            <a href="{{ post.url }}" class="post-read-more" aria-label="Leer: {{ post.data.title }}">Leer <span aria-hidden="true">→</span></a>
          </article>
        {% endfor %}
      </div>

    </div>
  </section>

  {# ── TESTIMONIOS ── #}
  <section class="section section--alt" id="prueba-social" aria-labelledby="testimonios-title">
    <div class="container">
      <p class="section__label reveal">
        <span aria-hidden="true"></span>Prueba social</p>
      <h2 class="section__title reveal reveal--delay-1" id="testimonios-title">
      Lo que dicen quienes<br>
        <em>ya confiaron en nosotros.</em>
      </h2>

      <div class="testimonials reveal reveal--delay-2">
        <div class="testimonials__list" role="tablist" aria-label="Seleccionar testimonio">
          {% for t in testimonios %}
            <button
          class="testimonial-tab{% if loop.first %} testimonial-tab--active{% endif %}"
          role="tab"
          aria-selected="{{ 'true' if loop.first else 'false' }}"
          aria-controls="testimonial-{{ loop.index }}"
          data-index="{{ loop.index0 }}"
        >
              <span class="testimonial-tab__name">{{ t.nombre }}</span>
              <span class="testimonial-tab__co">{{ t.cargo }} · {{ t.empresa }}</span>
            </button>
          {% endfor %}
        </div>

        <div class="testimonials__display">
          {% for t in testimonios %}
            <div
          class="testimonial-panel{% if loop.first %} testimonial-panel--active{% endif %}"
          role="tabpanel"
          id="testimonial-{{ loop.index }}"
          aria-hidden="{{ 'false' if loop.first else 'true' }}"
        >
              <blockquote class="testimonial-quote">
                <p>"{{ t.texto }}"</p>
              </blockquote>
              <footer class="testimonial-footer">
                <div class="testimonial-avatar" aria-hidden="true">{{ t.inicial }}</div>
                <div>
                  <p class="testimonial-name">{{ t.nombre }}</p>
                  <p class="testimonial-co mono">{{ t.cargo }} · {{ t.empresa }}</p>
                </div>
                <div class="testimonial-stars" aria-label="{{ t.estrellas }} de 5 estrellas">
                  {% for i in range(0, t.estrellas) %}★{% endfor %}
                </div>
              </footer>
            </div>
          {% endfor %}
        </div>
      </div>

      <div class="clients-strip reveal">
        <p class="clients-strip__label">Empresas que confían en nuestro trabajo</p>
        <ul class="clients-logos" aria-label="Clientes">
          {% for t in testimonios %}
            <li class="client-logo">{{ t.empresa }}</li>
          {% endfor %}
          <li class="client-logo">Aurum Propiedades</li>
          <li class="client-logo">Nexus Systems</li>
        </ul>
      </div>

    </div>
  </section>

  {# ── FAQ ── #}
  <section class="section" id="faq" aria-labelledby="faq-title">
    <div class="container">
      <div class="faq__layout">

        <div class="faq__left">
          <p class="section__label reveal">
            <span aria-hidden="true"></span>Preguntas frecuentes</p>
          <h2 class="section__title reveal reveal--delay-1" id="faq-title">
          Respuestas<br>
            <em>honestas.</em>
          </h2>
          <p class="section__sub reveal reveal--delay-2">
          Sin ambigüedades corporativas. Si tienes una pregunta que no está aquí, escríbenos directamente.
        </p>
          <a href="#contacto" class="btn btn--ghost reveal reveal--delay-3">Hacer una pregunta</a>
        </div>

        <div class="faq__list reveal reveal--delay-2">
          {% for item in faq %}
            <div class="faq-item" id="faq-{{ loop.index }}">
              <button
            class="faq-item__question"
            aria-expanded="{{ 'true' if loop.first else 'false' }}"
            aria-controls="faq-answer-{{ loop.index }}"
          >
                <span>{{ item.pregunta }}</span>
                <span class="faq-item__toggle" aria-hidden="true">+</span>
              </button>
              <div
            class="faq-item__answer"
            id="faq-answer-{{ loop.index }}"
            role="region"
            aria-labelledby="faq-{{ loop.index }}"
            {% if not loop.first %}hidden{% endif %}
          >
                <p>{{ item.respuesta }}</p>
              </div>
            </div>
          {% endfor %}
        </div>

      </div>
    </div>
  </section>

  {# ── CONTACTO ── #}

  <section class="section section--alt" id="contacto" aria-labelledby="contacto-title">
    <div class="container">
      <div class="contact__layout">

        <div class="contact__info">
          <p class="section__label reveal">
            <span aria-hidden="true"></span>Inicio de conversación</p>
          <h2 class="section__title reveal reveal--delay-1" id="contacto-title">
          Cuéntanos<br>tu <em>problema.</em>
          </h2>
          <p class="section__sub reveal reveal--delay-2">
          Sin formularios de ventas agresivos. Solo una conversación honesta sobre si podemos ayudarte.
        </p>

          <ul class="contact-channels reveal reveal--delay-2">
            <li class="contact-channel">
              <div class="contact-channel__icon" aria-hidden="true">
                {% include "partials/icons/mail.njk" %}
              </div>
              <div>
                <p class="contact-channel__label">Email directo</p>
                <button id="btn_copy_email" class="contact-channel__value" value="{{ site.siteEmail }}">Ponte en contacto con nosotros</button>
              </div>
            </li>
            {# <li class="contact-channel">
              <div class="contact-channel__icon" aria-hidden="true">
                {% include "partials/icons/message.njk" %}
              </div>
              <div>
                <p class="contact-channel__label">WhatsApp</p>
                <a class="contact-channel__value" href="https://wa.me/{{ site.siteWhatsapp }}">{{ site.siteWhatsapp }}</a>
              </div>
            </li> #}
            <li class="contact-channel">
              <div class="contact-channel__icon" aria-hidden="true">
                {% include "partials/icons/clock.njk" %}
              </div>
              <div>
                <p class="contact-channel__label">Horario de respuesta</p>
                <p class="contact-channel__value">Lun – Vie · 9am – 6pm (GMT-5)</p>
              </div>
            </li>
          </ul>
        </div>

        <div class="contact__form reveal reveal--delay-2">
          {% include "partials/contact-form.njk" %}
        </div>

      </div>
    </div>
  </section>

{% endblock %}