{% extends "layouts/base.njk" %}

{% block extraCss %}
  <link rel="stylesheet" href="/assets/css/blog-post.css">
{% endblock %}

{% block extraJs %}
  <script src="/assets/js/blog-post.js" defer></script>
{% endblock %}

{% block content %}

  <article class="article" itemscope itemtype="https://schema.org/BlogPosting">
    <meta itemprop="datePublished" content="{{ page.date | fechaISO }}">
    <meta itemprop="author" content="{{ autor or site.siteAuthor }}">

    {# ── HEADER ── #}
    <header class="article__header">
      <div class="container article__header-inner">

        {# Breadcrumb #}
        <nav class="breadcrumb" aria-label="Navegación de migas">
          <ol>
            <li>
              <a href="/">Inicio</a>
            </li>
            <li>
              <a href="/blog/">Blog</a>
            </li>
            <li aria-current="page">{{ title | truncar(40) }}</li>
          </ol>
        </nav>

        {# Kicker #}
        <div class="article__kicker">
          {% if categoria %}
            <span class="post-cat">{{ categoria }}</span>
          {% endif %}
          <time class="post-date" datetime="{{ page.date | fechaISO }}">
            {{ page.date | fechaLarga }}
          </time>
          <span class="post-date" aria-label="Tiempo de lectura">
            {{ content | tiempoLectura }} de lectura
        </span>
        </div>

        {# Title #}
        <h1 class="article__title" itemprop="headline">{{ title }}</h1>

        {% if resumen %}
          <p class="article__intro" itemprop="description">{{ resumen }}</p>
        {% endif %}

        {# Author + share #}
        <div class="article__meta">
          <div class="article__author" itemprop="author" itemscope itemtype="https://schema.org/Person">
            <div class="author-avatar" aria-hidden="true">
              {{ (autor or "T") | truncar(1) | upper }}
            </div>
            <div>
              <p class="author-name" itemprop="name">{{ autor or site.siteAuthor }}</p>
              <p class="mono">{{ cargoAutor or "The Silent Algorithm" }}</p>
            </div>
          </div>

          <div class="article__share">
            <span class="mono" style="color: var(--smoke); margin-right: 12px;">Compartir</span>
            <a href="https://twitter.com/intent/tweet?url={{ site.siteUrl }}{{ page.url }}&text={{ title | urlencode }}"
             class="share-btn" target="_blank" rel="noopener noreferrer" aria-label="Compartir en Twitter">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.744l7.73-8.835L1.254 2.25H8.08l4.253 5.622 5.91-5.622zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
            </a>
            <a href="https://www.linkedin.com/sharing/share-offsite/?url={{ site.siteUrl }}{{ page.url }}"
             class="share-btn" target="_blank" rel="noopener noreferrer" aria-label="Compartir en LinkedIn">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16 8a6 6 0 016 6v7h-4v-7a2 2 0 00-2-2 2 2 0 00-2 2v7h-4v-7a6 6 0 016-6zM2 9h4v12H2z"/><circle cx="4" cy="4" r="2"/></svg>
            </a>
          </div>
        </div>

      </div>
    </header>

    {# ── HERO IMAGE ── #}
    {% if imagenDestacada %}
      <div class="article__hero-image">
        <img
      src="{{ imagenDestacada }}"
      alt="{{ imagenAlt or title }}"
      width="1200" height="600"
      loading="eager"
      itemprop="image"
    >
      </div>
    {% else %}
      <div class="article__hero-placeholder" aria-hidden="true" style="{{ colorBg or 'background: var(--dusk)' }}">
        <span class="article__hero-symbol">∮</span>
      </div>
    {% endif %}

    {# ── BODY ── #}
    <div class="article__body-wrapper">
      <div class="container">
        <div class="article__layout">

          {# ── TOC (Table of Contents) ── #}
          <aside class="article__toc" aria-label="Tabla de contenidos">
            <p class="mono" style="color: var(--gold-dim); margin-bottom: 16px;">En este artículo</p>
            <nav id="toc" aria-label="Tabla de contenidos del artículo">
              {# Generated by JS from h2/h3 headings #}
            </nav>
          </aside>

          {# ── CONTENT ── #}
          <div class="article__content prose" itemprop="articleBody">
            {{ content | safe }}
          </div>

        </div>
      </div>
    </div>

    {# ── TAGS ── #}
    {% if etiquetas %}
      <div class="container">
        <div class="article__tags">
          <span class="mono" style="color: var(--smoke); margin-right: 12px;">Etiquetas:</span>
          {% for etiqueta in etiquetas %}
            {# <a href="/blog/etiqueta/{{ etiqueta | slug }}/" class="tag">{{ etiqueta }}</a> #}
            <span class="tag">{{ etiqueta }}</span>
          {% endfor %}
        </div>
      </div>
    {% endif %}

  </article>

  {# ── RELATED POSTS ── #}
  {% set relatedPosts = collections.blog | excluir(page) %}
  {% if relatedPosts.length %}
    {# <section class="section section--alt" aria-labelledby="related-title">
      <div class="container">
        <p class="section__label">
          <span aria-hidden="true"></span>Continúa leyendo</p>
        <h2 class="section__title" id="related-title">Artículos <em>relacionados.</em>
        </h2>
        <div class="blog-grid-secondary" role="list">
          {% for post in relatedPosts %}
            <article class="blog-post-card" role="listitem">
              <div class="post-meta">
                <span class="post-cat">{{ post.data.categoria }}</span>
                <time class="post-date" datetime="{{ post.date | fechaISO }}">{{ post.date | fechaCorta }}</time>
              </div>
              <h3 class="blog-post-card__title">
                <a href="{{ post.url }}">{{ post.data.title }}</a>
              </h3>
              <p class="blog-post-card__excerpt">{{ post.data.resumen | truncar(120) }}</p>
              <a href="{{ post.url }}" class="post-read-more">Leer <span aria-hidden="true">→</span></a>
            </article>
          {% endfor %}
        </div>
      </div>
    </section> #}
    <div style="background:red">{{relatedPosts.length}}</div>
  {% endif %}

  {# ── CTA BOTTOM ── #}
  <section class="section cta-block" aria-labelledby="cta-title">
    <div class="container cta-block__inner">
      <div>
        <h2 class="cta-block__title" id="cta-title">¿Listo para construir algo <em>que funcione</em>?</h2>
        <p class="cta-block__sub">Cuéntanos tu problema. Sin compromiso, sin presión.</p>
      </div>
      <a href="/#contacto" class="btn btn--primary">Iniciar conversación</a>
    </div>
  </section>

{% endblock %}