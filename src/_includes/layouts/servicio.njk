  {# ── PROCESO DE TRABAJO ── #}
  <section class="section" aria-labelledby="proceso-title">
    <div class="container">
      <p class="section__label reveal">
        <span aria-hidden="true"></span>Cómo trabajamos</p>
      <h2 class="section__title reveal reveal--delay-1" id="proceso-title">
      El proceso,<br>
        <em>paso a paso.</em>
      </h2>

      <ol class="proceso-steps reveal reveal--delay-2" aria-label="Pasos del proceso de trabajo">
        <li class="proceso-step">
          <span class="proceso-step__num">01</span>
          <h3 class="proceso-step__title">Discovery</h3>
          <p class="proceso-step__desc">Entendemos tu problema en profundidad antes de escribir una línea de código.</p>
        </li>
        <li class="proceso-step">
          <span class="proceso-step__num">02</span>
          <h3 class="proceso-step__title">Propuesta</h3>
          <p class="proceso-step__desc">Documento técnico y comercial detallado. Sin letra chica, sin sorpresas.</p>
        </li>
        <li class="proceso-step">
          <span class="proceso-step__num">03</span>
          <h3 class="proceso-step__title">Desarrollo</h3>
          <p class="proceso-step__desc">Sprints quincenales con demos reales. Ves el avance, no solo reportes.</p>
        </li>
        <li class="proceso-step">
          <span class="proceso-step__num">04</span>
          <h3 class="proceso-step__title">Testing</h3>
          <p class="proceso-step__desc">QA riguroso antes de cada entrega. Cero sorpresas en producción.</p>
        </li>
        <li class="proceso-step">
          <span class="proceso-step__num">05</span>
          <h3 class="proceso-step__title">Soporte</h3>
          <p class="proceso-step__desc">60 días de soporte post-entrega incluidos en todos los paquetes.</p>
        </li>
      </ol>

    </div>
  </section>

  {# ── CTA ── #}
  <section class="section cta-block" aria-labelledby="cta-servicio-title">
    <div class="container cta-block__inner">
      <div>
        <h2 class="cta-block__title" id="cta-servicio-title">
        ¿Este servicio es lo que<br>necesitas? <em>Hablemos.</em>
        </h2>
        <p class="cta-block__sub">Consulta inicial sin costo. 30 minutos que pueden cambiar tu negocio.</p>
      </div>
      <a href="/#contacto" id="btn-service" data-service="{{titleService}}" data-package="" class="btn btn--primary">
      Solicitar consulta gratuita
    </a>
    </div>
  </section>

{% endblock %}