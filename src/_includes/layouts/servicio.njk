{% extends "layouts/base.njk" %}

{% block extraCss %}
  <link rel="stylesheet" href="/assets/css/servicio.css">
{% endblock %}

{% block content %}

  {# ── HERO DEL SERVICIO ── #}
  <section class="servicio-hero" aria-labelledby="servicio-title">
    <div class="container servicio-hero__inner">
      <nav class="breadcrumb" aria-label="Navegación de migas">
        <ol>
          <li>
            <a href="/">Inicio</a>
          </li>
          <li>
            <a href="/#servicios">Servicios</a>
          </li>
          <li aria-current="page">{{ title }}</li>
        </ol>
      </nav>
      <p class="section__label reveal">
        <span aria-hidden="true"></span>Servicio detallado</p>
      <h1 class="servicio-hero__title reveal reveal--delay-1" id="servicio-title">{{ title }}</h1>
      <p class="servicio-hero__intro reveal reveal--delay-2">{{ descripcionLarga or resumen }}</p>

      <div class="servicio-hero__meta reveal reveal--delay-3">
        {% if tiempoEntrega %}
          <div class="servicio-meta-item">
            <span class="mono">Tiempo de entrega</span>
            <strong>{{ tiempoEntrega }}</strong>
          </div>
        {% endif %}
        {% if precioDesde %}
          <div class="servicio-meta-item">
            <span class="mono">Desde</span>
            <strong>${{ precioDesde }} USD</strong>
          </div>
        {% endif %}
        {% if garantia %}
          <div class="servicio-meta-item">
            <span class="mono">Soporte incluido</span>
            <strong>{{ garantia }}</strong>
          </div>
        {% endif %}
      </div>
    </div>
  </section>

  {# ── DESCRIPCIÓN COMPLETA (Markdown) ── #}
  {% if content | trim %}
    <section class="section">
      <div class="container">
        <div class="servicio-content prose reveal">
          {{ content | safe }}
        </div>
      </div>
    </section>
  {% endif %}

