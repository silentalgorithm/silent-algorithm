<header class="nav" id="navbar" role="banner">
  <div class="nav__inner">

    {# ── LOGO ── #}
    <a href="/" class="nav__logo" aria-label="{{ site.siteName }} — ir al inicio">
      <span class="nav__logo-main">{{ site.siteName }}</span>
      <span class="nav__logo-sub" aria-hidden="true">{{ site.siteTagline }}</span>
    </a>

    {# ── DESKTOP NAV ── #}
    <nav class="nav__links" aria-label="Navegación principal">
      <ul role="list">
        {% for link in site.navLinks %}
          <li>
            <a href="{{ link.url }}"
             {% if page.url == link.url or (link.url != '/' and page.url.startsWith(link.url)) %}
             aria-current="page"
             {% endif %}>
              {{ link.label }}
            </a>
          </li>
        {% endfor %}
      </ul>
    </nav>

    {# ── CTA ── #}
    <a href="/#contacto" class="btn btn--nav-cta">Conversemos</a>

    {# ── HAMBURGER (mobile) ── #}
    <button
      class="nav__hamburger"
      id="navToggle"
      aria-expanded="false"
      aria-controls="mobileMenu"
      aria-label="Abrir menú de navegación"
    >
      <span class="nav__hamburger-bar"></span>
      <span class="nav__hamburger-bar"></span>
      <span class="nav__hamburger-bar"></span>
    </button>

  </div>

  {# ── MOBILE MENU ── #}
  <div class="nav__mobile" id="mobileMenu" role="dialog" aria-modal="true" aria-label="Menú móvil" hidden>
    <nav aria-label="Menú móvil">
      <ul role="list">
        {% for link in site.navLinks %}
          <li>
            <a href="{{ link.url }}" class="nav__mobile-link">{{ link.label }}</a>
          </li>
        {% endfor %}
        <li>
          <a href="/#contacto" class="btn btn--primary" style="display:block; text-align:center; margin-top: 24px;">
            Conversemos
          </a>
        </li>
      </ul>
    </nav>
  </div>

</header>

